# Include only for $OSNAME
BSDCFG_SHARE="/usr/share/bsdconfig"
. $BSDCFG_SHARE/common.subr || exit 1

: "${BSDDIALOG_YES=0}"

pkg_install () {
	exec 5>&1
	# WIP
	#pkgerr=$(chroot "$BSDINSTALL_CHROOT" pkg install $* 2>&1 1>&5)
	pkgerr=$(pkg install $* 2>&1 1>&5)
	retval=$?
	exec 5>&-
	if [ $retval -ne 0 ]; then
		bsddialog --backtitle "$OSNAME Installer" --title Desktop \
		    --msgbox "Error during package installation: $pkgerr\n\n
Packages may currently be building, this is a common issue, try installing
again later." \
		    0 0
		exit 1
	fi
}

#### SECTION 1: Yes-No question, install tools, and checks ####
bsddialog --backtitle "$OSNAME Installer" --title Desktop --colors \
    --yesno "$OSNAME provides a variety of graphical environments that can be
easily installed through ports and packages. Refer to the $OSNAME Handbook
available at \Zuhttps://docs.freebsd.org\Zn.\n\nWould you like to install the
GPU drivers, Xorg, KDE Plasma, and a display manager now, and have them start
automatically at the next system reboot?\n\nPlease note this is an experimental
feature." \
	0 0
[ $? -eq $BSDDIALOG_YES ] || exit 1

# bsdinstall/scripts/firmware to know more about pkg(8) and resolv.conf(5)
cp -f $BSDINSTALL_TMPETC/resolv.conf "$BSDINSTALL_CHROOT/etc/"
ASSUME_ALWAYS_YES=yes pkg update
pkg_install bsdinstall-desktop bsdinstall-gpu bsdinstall-dm bsdinstall-de

bsdinstall-desktop-checks || exit 1

#### SECTION 2: GPU ####
exec 5>&1
gpu=$(bsdinstall-gpu 2>&1 1>&5)
retval=$?
exec 5>&-
[ $retval -ne 0 ] && exit 1

#### SECTION 3: Display Manager ####
exec 5>&1
dm=$(bsdinstall-dm 2>&1 1>&5)
retval=$?
exec 5>&-
[ $retval -ne 0 ] && exit 1

#### SECTION 4: Users ####
exec 5>&1
BSDINSTALL_USERS=$(bsdinstall-desktop-users 2>&1 1>&5)
retval=$?
exec 5>&-
[ $retval -ne 0 ] && exit 1

export BSDINSTALL_USERS

#### SECTION 5: Installation ####
pkg_install $gpu xorg `bsdinstall-de` $dm bsdinstall-desktop-audio

#### SECTION 6: Success Message ####
users=`echo "$BSDINSTALL_USERS" | sed 's/ /, /g'`

finalmsg="Desktop installation completed.\n\n
A display manager will start automatically and allow login at the next startup.
The enabled users with configured settings are: \Zb$users\Zb."

if [ "`sysctl -n kern.vm_guest`" = vbox ]; then
	finalmsg="$finalmsg\n\n\
\ZbTIP\ZB. VirtualBox setting: select VBoxSVGA as graphics controller, and
disable 3D acceleration."
fi

bsddialog --backtitle "$OSNAME Installer" --title Desktop --colors \
    --msgbox "$finalmsg" 0 0
